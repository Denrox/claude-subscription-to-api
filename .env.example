REFRESH_INTERVAL_MS=7200000
REFRESH_MODEL=claude-haiku-4-5-20251001
REFRESH_ON_BOOT=1
CLAUDE_TIMEOUT_MS=120000

API_ENABLED=1
API_ALLOW_TOOLS=0
API_MAX_CONCURRENT=2
API_TIMEOUT_MS=600000
