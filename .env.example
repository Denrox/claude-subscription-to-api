# Copy to .env and fill in. `.env` is gitignored — it holds the UI password.

# ---- host wiring (docker-compose) ----
# Whose home gets the credentials, and which uid writes them.
HOST_HOME=/home/youruser
HOST_UID=1000
HOST_GID=1000
# Where the host's claude binary lives. Default: $HOST_HOME/.local/bin/claude
#HOST_CLAUDE_BIN=/usr/local/bin/claude
# Published loopback port.
HOST_PORT=3000

# ---- auth (required) ----
# Either a plaintext password...
AUTH_PASSWORD=change-me
# ...or, preferred, a hash from `npm run hash-password` (takes precedence):
#AUTH_PASSWORD_HASH=scrypt$...$...

# Signs session cookies. Generate: openssl rand -hex 32
# Unset = random per boot, which logs everyone out on every restart.
SESSION_SECRET=
# How long a session lasts, and whether the cookie is HTTPS-only.
SESSION_TTL_HOURS=720
COOKIE_SECURE=0
# Set to the number of proxies in front of the app (e.g. 1) so login throttling
# sees real client IPs. Leave unset when nothing sets X-Forwarded-For.
#TRUST_PROXY=1

# ---- keep-alive ----
# How often to run the CLI so it rotates its own tokens (default 4h). Must stay
# comfortably under the access token's lifetime (~8h observed).
REFRESH_INTERVAL_MS=14400000
REFRESH_MODEL=claude-haiku-4-5-20251001
REFRESH_ON_BOOT=1
CLAUDE_TIMEOUT_MS=120000
