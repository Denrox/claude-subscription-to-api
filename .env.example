HOST_HOME=/home/youruser
HOST_UID=1000
HOST_GID=1000
#HOST_CLAUDE_BIN=/usr/local/bin/claude
HOST_PORT=80

AUTH_PASSWORD=change-me
#AUTH_PASSWORD_HASH=scrypt$...$...

SESSION_SECRET=
SESSION_TTL_HOURS=720
COOKIE_SECURE=0
